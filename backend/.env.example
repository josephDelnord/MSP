# MSP - Mikrotik Provisioning Manager
# Configuration d'environnement

# Application
APP_NAME="Mikrotik Provisioning Manager"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql://msp:msp_password@localhost:5432/msp_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Mikrotik defaults
MIKROTIK_DEFAULT_PORT_API=8728
MIKROTIK_DEFAULT_PORT_SSH=22
MIKROTIK_DEFAULT_PORT_API_SSL=8729
MIKROTIK_DEFAULT_USERNAME=admin
MIKROTIK_DEFAULT_PASSWORD=
MIKROTIK_DEFAULT_IP=192.168.88.1

# Templates
TEMPLATES_DIR=/app/templates

# Email (notifications)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=msp@localhost
